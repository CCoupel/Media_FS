{
  "name": "Media_FS",
  "team_name": "media-fs-team",
  "org": "CCoupel",
  "project": "Media_FS",
  "description": "Systeme de fichiers virtuel (WinFSP sous Windows, FUSE sous Linux) exposant les bibliotheques Jellyfin/Emby/Plex comme un lecteur monte, navigable depuis l'Explorateur Windows ou un gestionnaire de fichiers Linux.",
  "version": "1.1.2",
