            "checks": [
              "local-target-dir",
              "windows-toolchain"
            ]
          }
        }
      },
      {
        "name": "PROD",
        "order": 2,
        "publish": {
          "mode": "rebuild-ci",
          "trigger": "git-tag",
          "pipeline": ".github/workflows/release.yml"
        },
        "deploy": {
          "mechanism": "vps",
          "target": "github-release"
        },
        "access": {
          "method": "github",
