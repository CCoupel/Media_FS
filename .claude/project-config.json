  "security": {
    "concerns": [
      "auth"
    ]
  },
  "commands": {
    "build": "CGO_ENABLED=1 CGO_CFLAGS=\"-IC:/winfsp/inc/fuse\" CGO_LDFLAGS=\"-LC:/winfsp/lib -lwinfsp\" go build -o dist/mediafs.exe ./cmd/mediafs",
    "test": "go test ./...",
    "lint": "golangci-lint run",
    "audit": "govulncheck ./...",
    "ci": "scripts/ci.sh",
    "typecheck": "",
    "coverage": "go test -cover ./...",
    "test_fast": "go test -short ./...",
    "test_targeted": "go test {TARGETS}",
    "smoke": ""
  },
