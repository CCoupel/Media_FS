  "stack": {
    "backend": {
      "language": "go",
      "framework": null,
      "notes": "Go 1.25, CGO obligatoire (cgofuse -> WinFSP/libfuse), systray (fyne.io/systray), webui Go html/template embarquee"
    },
    "frontend": null,
    "mobile": null,
    "firmware": null,
    "plugin": null,
    "database": {
      "primary": "sqlite",
      "orm": null,
      "driver": "modernc.org/sqlite (pure Go)"
    }
  },
